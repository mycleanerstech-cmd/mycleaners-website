# Billing API (Railway) — public pickup integration
#
# These values are read on the SERVER only, in `lib/leads-api.ts` and the
# `app/api/*` route handlers.
#
# ⚠️  Never prefix either with `NEXT_PUBLIC_`. That would inline them into the
#    browser bundle, where anyone could read the key off the page and submit
#    leads to your database at will. The whole reason the pickup form posts to
#    `/api/pickup` rather than calling Railway directly is to keep this key
#    off the client.
#
# Mint a key with:
#   pnpm --filter @mycleaners/api exec tsx src/scripts/create-api-client.ts \
#     --name "Mycleaners Website" --scopes leads:create,stores:read

# Base URL of the billing API, e.g. https://billing-api.up.railway.app
# The proxy appends /api/v1 itself.
LEADS_API_URL=

# Scoped API key. Shown once when minted and never recoverable — if it is lost,
# re-run the script above to rotate it.
LEADS_API_KEY=
